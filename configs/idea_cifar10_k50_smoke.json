{
  "data": {
    "dataset": "cifar10",
    "data_root": "/root/autodl-tmp/data",
    "num_clients": 50,
    "dirichlet_alpha": 0.5,
    "public_ratio": 0.1,
    "split_seed": 42,
    "noise_seed": 2026
  },
  "model": {
    "fedds_pretrained": false
  },
  "fedcorr": {
    "iteration1": 1,
    "local_ep": 1,
    "local_bs": 10,
    "lr": 0.03,
    "momentum": 0.5,
    "beta": 5.0,
    "mixup": true,
    "lid_k": 20,
    "relabel_ratio": 0.5,
    "confidence_thres": 0.5,
    "train_transform": "train",
    "loss_on": "logit"
  },
  "fedds": {
    "rounds": 3,
    "frac": 0.1,
    "local_ep": 1,
    "local_bs": 64,
    "lr": 0.01,
    "momentum": 0.9,
    "public_bs": 64,
    "last_k": 3,
    "ds_max_iter": 500,
    "ds_tol": 1e-05,
    "ds_use_class_prior": false
  },
  "runtime": {
    "device": "cuda:0",
    "num_workers": 2,
    "seed": 1,
    "save_every": 0,
    "checkpoint_models": false,
    "synthetic": false,
    "arms": ["fedcorr+fedds"],
    "output_root": "outputs",
    "exp_name": "smoke_real_cifar10_k50"
  }
}
